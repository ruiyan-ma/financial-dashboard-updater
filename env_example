# Notion Config
INTERNAL_INTEGRATION_TOKEN=your_notion_token
ASSETS_DATABASE_ID=your_assets_db_id
CURRENCIES_DATABASE_ID=your_currency_db_id
INC_EXP_DATABASE_ID=your_income_expense_db_id
CATEGORIES_DATABASE_ID=your_categories_db_id
ACCOUNTS_DATABASE_ID=your_accounts_db_id

# AI Model Config (OpenAI-compatible provider)
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen3.6-35B-A3B

# 手动触发端口，默认 5001
TRIGGER_PORT=5001

# Notion 分类和账户缓存的存活时间，默认 300 秒
XACT_OPTION_CACHE_TTL=300

# 时区设置 (例如 Asia/Shanghai)
TIMEZONE=Asia/Shanghai